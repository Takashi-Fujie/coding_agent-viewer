{
  "name": "coding-agent-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "コーディングエージェントの活動ログを可視化するローカル Web アプリ",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "preserve": "npm run build:web",
    "serve": "tsx server/index.ts",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "spec:check": "tsx scripts/spec-check.ts",
    "report": "tsx scripts/report.ts",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e && npm run report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
